    {
      "id": "explorer_select_beta",
      "category": "explorer",
      "instruction": "Select the file 'beta' in the file list (don't open it).",
      "app_title_regex": "bench_files - File Explorer",
      "expected_action_type": "select",
      "notes": "Select without opening. Setup selects 'alpha' first.",
