      "app_title_regex": "^Calculator$",
      "expected_action_type": "type_text",
      "notes": "Typing into an app with no text box. An extra Enter repeats the operation (100 -> 400).",
      "setup": [
        {
          "open_app": "Calculator"
        },
        {
          "invoke": {
            "window": "^Calculator$",
