      "notes": "Keyboard shortcut. Setup puts a 9 on the display first.",
      "setup": [
        {
          "open_app": "Calculator"
        },
        {
          "invoke": {
            "window": "^Calculator$",
            "name": "Nine",
            "control_type": "Button"
          }
        }
      ],
      "verify": [
        {
          "element": {
            "window": "^Calculator$",
            "automation_id": "CalculatorResults"
          },
          "property": "name",
          "equals": "Display is 0"
        }
      ]
    },
