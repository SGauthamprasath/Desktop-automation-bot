{
  "workspace": {
    "bench_scratch.txt": "Scratch file for the agent benchmark - safe to change.\n",
    "bench_files/alpha.txt": "alpha\n",
    "bench_files/beta.txt": "beta\n",
    "bench_files/gamma.txt": "gamma\n",
    "bench_files/sub/inner.txt": "inner\n"
  },
  "tasks": [
    {
      "id": "notepad_set_value",
      "category": "notepad",
      "instruction": "Type 'Hello from my agent' into the document.",
      "app_title_regex": "bench_scratch.txt",
      "expected_action_type": "set_value",
      "notes": "set_value on a native edit control.",
      "setup": [
        {
          "open_file": "{workspace}/bench_scratch.txt"
        },
        {
          "set_text": {
            "window": "bench_scratch.txt",
            "control_type": "Document",
            "text": "old text"
          }
        }
      ],
      "verify": [
        {
          "element": {
            "window": "bench_scratch.txt",
            "control_type": "Document"
          },
          "property": "value",
          "equals": "Hello from my agent"
        }
      ]
    },
    {
      "id": "notepad_invoke_menu",
      "category": "notepad",
      "instruction": "Open the Edit menu (just open it, don't click anything inside).",
      "app_title_regex": "bench_scratch.txt",
      "expected_action_type": "expand",
      "notes": "Open a menu and stop.",
      "setup": [
        {
          "open_file": "{workspace}/bench_scratch.txt"
        }
      ],
      "verify": [
        {
          "element": {
            "window": "bench_scratch.txt",
            "name": "Edit",
            "control_type": "MenuItem"
          },
          "property": "expanded",
          "equals": true
        }
      ]
    },
    {
      "id": "notepad_open_file_menu",
      "category": "notepad",
      "instruction": "Open the File menu.",
      "app_title_regex": "bench_scratch.txt",
      "expected_action_type": "expand",
      "notes": "Easy to over-do: clicking 'Open' inside it opens a file dialog (caught as a side effect).",
      "setup": [
        {
          "open_file": "{workspace}/bench_scratch.txt"
        }
      ],
      "verify": [
        {
          "element": {
            "window": "bench_scratch.txt",
            "name": "File",
            "control_type": "MenuItem"
          },
          "property": "expanded",
          "equals": true
        }
      ]
    },
    {
      "id": "notepad_toggle_wordwrap",
      "category": "notepad",
      "instruction": "Enable Word Wrap from the View menu.",
      "app_title_regex": "bench_scratch.txt",
      "expected_action_type": "toggle",
      "notes": "Menu item inside a flyout menu.",
      "setup": [
        {
          "open_file": "{workspace}/bench_scratch.txt"
        },
        {
          "menu_toggle": {
            "window": "bench_scratch.txt",
            "menu": "View",
            "item": "Word wrap",
            "state": false
          }
        }
      ],
      "verify": [
        {
          "element": {
            "window": "bench_scratch.txt",
            "menu": "View",
            "name": "Word wrap",
            "control_type": "MenuItem"
          },
          "property": "toggled",
          "equals": true
        }
      ],
      "teardown": [
        {
          "menu_toggle": {
            "window": "bench_scratch.txt",
            "menu": "View",
            "item": "Word wrap",
            "state": true
          }
        }
      ]
    },
    {
      "id": "notepad_scroll_down",
      "category": "notepad",
      "instruction": "Scroll down in the document.",
      "app_title_regex": "bench_scratch.txt",
      "expected_action_type": "scroll",
      "notes": "Scroll pattern on the document.",
      "setup": [
        {
          "open_file": "{workspace}/bench_scratch.txt"
        },
        {
          "set_text": {
            "window": "bench_scratch.txt",
            "control_type": "Document",
            "text": {
              "repeat": "line {i} of the scroll test",
              "count": 300
            }
          }
        }
      ],
      "verify": [
        {
          "element": {
            "window": "bench_scratch.txt",
            "control_type": "Document"
          },
          "property": "scroll_percent",
          "min": 1
        }
      ]
    },
    {
      "id": "calc_open_and_add",
      "category": "calculator",
      "instruction": "Open Calculator and calculate 12 + 7.",
      "expected_action_type": "open_app",
      "notes": "Starts with no window: the agent must open_app first.",
      "setup": [
        {
          "close_windows": "^Calculator$"
        }
      ],
      "allow_new_window": "^Calculator$",
      "verify": [
        {
          "element": {
            "window": "^Calculator$",
            "automation_id": "CalculatorResults"
          },
          "property": "name",
          "equals": "Display is 19"
        }
      ]
    },
    {
      "id": "calc_press_escape",
      "category": "calculator",
      "instruction": "Clear the Calculator display using the Escape key.",
